# ─────────────────────────────────────────────
# Python Stock Scheduler
# ─────────────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies needed by some Python packages (psycopg2-binary, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for Docker layer caching
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt && \
    ln -s /usr/local/lib/python3.11/site-packages/pandas_ta_classic \
    /usr/local/lib/python3.11/site-packages/pandas_ta


# Copy full project source
COPY src/ ./src/

# Set Python path so imports work correctly
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

# Run the scheduler
CMD ["python", "src/main.py"]
