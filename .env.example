# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values.
#
# LOCAL DEV:  DB_HOST=localhost, DB_PORT=5433, RABBITMQ_HOST=localhost
# DOCKER:     DB_HOST / RABBITMQ_HOST are overridden by docker-compose.yml
#             so you do NOT need to change these values for Docker.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=borsa_db
DB_HOST=localhost
DB_PORT=5433

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_THIS_PASSWORD
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Telegram Notifications
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
